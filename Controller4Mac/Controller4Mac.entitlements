<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Controller4Mac.entitlements
    
    App Sandbox is DISABLED (set to false).
    
    Why: CGEvent.post() — used in Phase 2 to simulate mouse movements,
    clicks, and keystrokes — silently fails when the App Sandbox is active
    because the sandbox blocks inter-process event injection. System utilities
    that perform global HID event injection must run unsandboxed.
    
    Trade-off: This app cannot be submitted to the Mac App Store under this
    configuration. That is the correct and expected trade-off for a
    system-level input remapping utility.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
